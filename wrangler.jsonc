{
  // Cloudflare Workers: static game files (see .assetsignore) + the feedback API in src/worker.js
  "name": "airline",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin"] },
  "d1_databases": [{ "binding": "DB", "database_name": "airline-feedback", "database_id": "ad920505-3c4f-4889-a7e9-0fef9ab784b5" }],
  // test server: `npx wrangler deploy --env test` → Worker "airline-test" (test.skyseatycoon.com), built from the `test` branch
  "env": {
    "test": {
      "vars": { "STAGE": "test" },
      "assets": { "directory": "./", "binding": "ASSETS", "run_worker_first": true },
      "d1_databases": [{ "binding": "DB", "database_name": "airline-feedback", "database_id": "ad920505-3c4f-4889-a7e9-0fef9ab784b5" }]
    }
  }
}
